# Gemini API Key (from https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock Long-term API Key (Bearer Token)
# Get this from AWS Bedrock console: https://console.aws.amazon.com/bedrock/
# Go to: Bedrock > API keys > Generate long-term API key
VITE_AWS_BEDROCK_API_KEY=your_bedrock_api_key_here

# AWS Bedrock region (must be a region with Claude models enabled)
# Available: us-east-1, us-west-2, eu-west-1, ap-northeast-1
VITE_AWS_BEDROCK_REGION=us-east-1
